# Application settings. Copy this file to .env before running the API locally.
APP_NAME=BizReg API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Keep this secret unique and private. Generate a new value before any deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker publishes these services to localhost at the ports below.
DATABASE_URL=postgresql+psycopg://bizreg:bizreg_dev_password@localhost:5432/bizreg
REDIS_URL=redis://localhost:6380/0
DOCUMENT_STORAGE_PATH=./storage/documents

# A comma-separated allow-list will be used by CORS middleware in Phase 9.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Docker Compose reads these values to initialise the local PostgreSQL container.
# They must match the credentials embedded in DATABASE_URL above.
POSTGRES_DB=bizreg
POSTGRES_USER=bizreg
POSTGRES_PASSWORD=bizreg_dev_password
REDIS_HOST_PORT=6380
