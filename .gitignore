# ── Secrets ──────────────────────────────────────────────────────────────────
# Local .env files contain credentials and must never be committed.
.env
.env.*
!.env.example

# ── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/coverage/
frontend/tsconfig.tsbuildinfo
frontend/build.log

# ── Backend — Python ─────────────────────────────────────────────────────────
# Virtual environment
backend/.venv/

# Byte-compiled files (all nesting depths)
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo

# Test / type-check artefacts
backend/.pytest_cache/
backend/.mypy_cache/
backend/coverage.xml
backend/.coverage
.coverage

# Runtime document storage (created automatically on first upload)
backend/storage/

# ── IDE and OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
